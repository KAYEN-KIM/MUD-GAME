# Production-like Environment Configuration Example
# Copy this file to the project root as .env.prodlike and fill in the values

# Environment
NODE_ENV=production
PORT=3000
TZ=Asia/Seoul

# Database (use container hostname in docker-compose network)
DATABASE_URL=postgresql://mud:mudpass@mud-postgres:5432/mud

# Redis (use container hostname in docker-compose network)
REDIS_URL=redis://mud-redis:6379

# Security (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-jwt-secret-change-in-production
ADMIN_KEY=your-admin-key-change-this

# Rate Limiting
RL_CHAT_PER_SEC=5
RL_MOVE_PER_SEC=10
RL_COMBAT_TURN_PER_SEC=5

# Combat Timing
TURN_SEC_FAST=6
TURN_SEC_TACTICAL=9
TIMEBANK_ADD_SEC=6
TIMEBANK_PER_ENCOUNTER=1

# Cooldowns
CD_HUNT_MS=2000

# Season Policy (CRITICAL: Production Default)
# MAX_UNLOCKED_SEASON=1 means only Season 1 is accessible
# NEVER set TEST_MODE=true in production
MAX_UNLOCKED_SEASON=1
TEST_MODE=false

# CORS (optional, if needed)
# CORS_ORIGIN=https://yourdomain.com

# WebSocket (optional, if client needs to know)
# WS_BASE_URL=wss://yourdomain.com

